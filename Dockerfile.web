# The store's web app (the same Expo code as the Android/iOS app), for Railway or any Docker host.
# Build from the repository root: docker build -f Dockerfile.web .
# Build-time settings (Railway passes service variables as build args):
#   EXPO_PUBLIC_MEDUSA_BACKEND_URL  server address (default: the shared Railway server)
#   APP_STORE                       which store (apps/mobile/stores/<slug>.json), default spir
FROM node:22-bookworm-slim AS build
WORKDIR /app
ARG EXPO_PUBLIC_MEDUSA_BACKEND_URL
ARG APP_STORE=spir
ENV EXPO_PUBLIC_MEDUSA_BACKEND_URL=$EXPO_PUBLIC_MEDUSA_BACKEND_URL APP_STORE=$APP_STORE CI=1 EXPO_NO_TELEMETRY=1
COPY package.json package-lock.json .npmrc ./
COPY apps/mobile/package.json apps/mobile/package.json
RUN npm ci --workspace=@spir/mobile --include-workspace-root --no-audit --no-fund
COPY apps/mobile apps/mobile
WORKDIR /app/apps/mobile
RUN npx expo export -p web --output-dir dist

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/apps/mobile/dist ./dist
COPY apps/mobile/web/server.js ./server.js
EXPOSE 8080
CMD ["node", "server.js", "dist"]
