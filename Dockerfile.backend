# Medusa backend (API + admin dashboard) for Railway / any Docker host.
# Build from the repository root: docker build -f Dockerfile.backend .
FROM node:22-bookworm-slim AS build
WORKDIR /app
ENV NODE_OPTIONS=--max-old-space-size=4096
COPY package.json package-lock.json .npmrc ./
COPY apps/backend/package.json apps/backend/package.json
# install only the backend workspace (skips the Expo app and the storefront)
RUN npm ci --workspace=@dtc/backend --include-workspace-root --no-audit --no-fund
COPY apps/backend apps/backend
WORKDIR /app/apps/backend
RUN mkdir -p node_modules && npx medusa build \
 && cp -r src/scripts/demo-assets .medusa/server/src/scripts/demo-assets

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/node_modules /app/node_modules
COPY --from=build /app/apps/backend/.medusa/server /app/apps/backend/.medusa/server
COPY --from=build /app/apps/backend/package.json /app/apps/backend/package.json
COPY --from=build /app/apps/backend/node_modules /app/apps/backend/node_modules
WORKDIR /app/apps/backend/.medusa/server
# uploaded files (mount a volume here)
RUN mkdir -p static
EXPOSE 9000
# migrations + idempotent demo data, then the server
CMD ["sh", "-c", "npx medusa db:migrate && npx medusa exec ./src/scripts/seed-admin.js && if [ \"$SEED_DEMO\" = \"true\" ]; then npx medusa exec ./src/scripts/seed-demo-brands.js; npx medusa exec ./src/scripts/seed-demo-sale.js; npx medusa exec ./src/scripts/seed-figma-layout.js; fi; npx medusa start"]
