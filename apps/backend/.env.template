STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend

# --- Spir Shop ---
STOREFRONT_URL=http://localhost:8000
BACKEND_PUBLIC_URL=http://localhost:9000
STORE_BRAND_NAME=Spir Shop

# Meta (Facebook/Instagram) catalog feed: GET /feeds/meta
META_FEED_CURRENCY=iqd
STOREFRONT_COUNTRY_CODE=iq

# Telegram bot (create with @BotFather)
TELEGRAM_BOT_TOKEN=
# Chat/group id that receives new-order notifications
TELEGRAM_ADMIN_CHAT_ID=
# Any random string; Telegram sends it back in a header to authenticate the webhook
TELEGRAM_WEBHOOK_SECRET=

# Mobile app version check (GET /store/mobile-version). Store metadata keys override these.
MOBILE_LATEST_VERSION=1.0.0
MOBILE_MIN_VERSION=1.0.0
MOBILE_ANDROID_URL=
MOBILE_IOS_URL=
MOBILE_UPDATE_MESSAGE=

# Push notifications (Expo). EXPO_ACCESS_TOKEN only if "enhanced push security" is enabled.
EXPO_ACCESS_TOKEN=
# Abandoned-cart reminder (job runs every 30 min)
ABANDONED_CART_HOURS=3
ABANDONED_CART_TITLE=
ABANDONED_CART_BODY=

# Public base URL of uploaded files (images, stories, APK updates)
FILE_BACKEND_URL=http://localhost:9000/static

# Ship app updates from GitHub Releases (owner/repo, public repo). Optional GITHUB_TOKEN raises rate limits.
MOBILE_GITHUB_REPO=inzohussein-blip/spir-shop
GITHUB_TOKEN=

# --- Multi-store access ---
# Admin users that manage every store (comma separated). Falls back to ADMIN_EMAIL.
# Any other admin user only manages the stores whose owner email is theirs.
PLATFORM_ADMIN_EMAILS=

# --- Deployment ---
# First admin, created on deploy when it doesn't exist yet
ADMIN_EMAIL=
ADMIN_PASSWORD=
# "false" when the host runs deploy/release.sh as a pre-deploy step (Railway)
RUN_RELEASE_ON_START=true
# "true" loads demo brands, sale, home layout and a demo store
SEED_DEMO=false
